{
    "schema_version":  1,
    "tools":  {
                  "model_overview":  {
                                         "matlab_release":  "\u003e=R2023a",
                                         "matlab_function":  "model_overview",
                                         "title":  "Model Overview",
                                         "description":  "Get a high-level view of the model. Prefer model_context first for task-oriented/cache-aware context; use model_overview when you explicitly need a hierarchy/tree/interface overview.\n\nGet a high-level view of the model showing subsystem hierarchy, interfaces, and connections. Use this when first encountering a model to understand the big picture before diving into details.",
                                         "annotations":  {
                                                             "readOnlyHint":  true,
                                                             "destructiveHint":  false,
                                                             "idempotentHint":  true,
                                                             "openWorldHint":  false
                                                         },
                                         "inputSchema":  {
                                                             "type":  "object",
                                                             "properties":  {
                                                                                "model":  {
                                                                                              "type":  "string",
                                                                                              "description":  "Model filename (e.g. MyModel.slx)"
                                                                                          },
                                                                                "scope":  {
                                                                                              "type":  "string",
                                                                                              "description":  "Focus on specific subsystem. Use \u0027root\u0027 for entire model or a block ID like \u0027blk_10\u0027 for a specific subsystem"
                                                                                          },
                                                                                "detail":  {
                                                                                               "type":  "string",
                                                                                               "description":  "Level of detail: \u0027tree\u0027 (component hierarchy only — no port or signal info), \u0027interfaces\u0027 (component hierarchy + input/output port names for each component), or \u0027full\u0027 (component hierarchy + port names + top-level component signal connections)"
                                                                                           }
                                                                            },
                                                             "required":  [
                                                                              "model",
                                                                              "scope",
                                                                              "detail"
                                                                          ]
                                                         }
                                     },
                  "model_read":  {
                                     "matlab_release":  "\u003e=R2023a",
                                     "matlab_function":  "model_read",
                                     "title":  "Model Read",
                                     "description":  "Inspect the structure and algorithmic behavior of a Simulink model. Prefer model_context first for engineering tasks or initial model understanding because it is cache-aware and compact; use model_read when you specifically need SATK algorithmic expressions, block IDs, or deeper topology for a known scope.\n\nInspect the structure and algorithmic behavior of a Simulink model. Returns block topology, connections, and expressions showing what each block does.\n\nExpression notation: uN(source) = input port N with source block.port in parentheses; yN = output port N; @Param(value) = parameter with actual set-value from the block. Example: y1 = @Gain(Kp) * u1(blk_5.y1) means output 1 = Gain parameter times input 1 (from block 5\u0027s output 1). When value is numeric (e.g., @Gain(5000)), you have the final value. When value is a variable reference (e.g., @Gain(Kp)), use model_resolve_params to get the numeric value.\n\nModel Reference, Subsystem Reference, and Library blocks show interfaces only, not internal content.",
                                     "annotations":  {
                                                         "readOnlyHint":  true,
                                                         "destructiveHint":  false,
                                                         "idempotentHint":  true,
                                                         "openWorldHint":  false
                                                     },
                                     "inputSchema":  {
                                                         "type":  "object",
                                                         "properties":  {
                                                                            "model":  {
                                                                                          "type":  "string",
                                                                                          "description":  "Model filename (e.g. MyModel.slx)"
                                                                                      },
                                                                            "scope":  {
                                                                                          "type":  "string",
                                                                                          "description":  "Starting scope - use \u0027root\u0027 for model top level or a block ID like \u0027blk_16\u0027"
                                                                                      },
                                                                            "depth":  {
                                                                                          "type":  "string",
                                                                                          "description":  "Hierarchy depth limit as string. \u00270\u0027=current level only, \u00271\u0027=one level down, \u0027inf\u0027=full hierarchy"
                                                                                      }
                                                                        },
                                                         "required":  [
                                                                          "model",
                                                                          "scope",
                                                                          "depth"
                                                                      ]
                                                     }
                                 },
                  "model_query_params":  {
                                             "matlab_release":  "\u003e=R2023a",
                                             "matlab_function":  "model_query_params",
                                             "title":  "Model Query Params",
                                             "description":  "Provides random access to any Simulink parameter on blocks, signals, or model configuration. Complements model_read by exposing values not included in the model graph.\n\nUse when you need:\n- Parameters not in model_read expressions (sample times, state names, port dimensions)\n- Model configuration (Solver, StopTime, RelTol, code generation options)\n- Signal properties beyond names (DataLogging, OutDataTypeStr, Min, Max)\n- Targeted verification after model_configure without re-reading the full graph\n\nIf model_read already shows the value in an expression (e.g., @Gain(Kp)), you have the set-value. Use model_resolve_params to resolve variable references to numeric values.\n\nUse compile=true only if certain the parameter requires compilation (e.g., CompiledPortWidths). If unsure, use default; PARAM_UNAVAILABLE error will indicate if compile is needed.",
                                             "annotations":  {
                                                                 "readOnlyHint":  true,
                                                                 "destructiveHint":  false,
                                                                 "idempotentHint":  true,
                                                                 "openWorldHint":  false
                                                             },
                                             "inputSchema":  {
                                                                 "type":  "object",
                                                                 "properties":  {
                                                                                    "model":  {
                                                                                                  "type":  "string",
                                                                                                  "description":  "Model filename (e.g. MyModel.slx)"
                                                                                              },
                                                                                    "targets":  {
                                                                                                    "type":  "string",
                                                                                                    "description":  "JSON array of target IDs - blocks (blk_5), signals (blk_5.y1 -\u003e blk_8.u1), or config (config:ModelName)"
                                                                                                },
                                                                                    "params":  {
                                                                                                   "type":  "string",
                                                                                                   "description":  "JSON array of param names like \u0027[\"Gain\", \"SampleTime\"]\u0027 or \u0027[\"all\"]\u0027 for all parameters"
                                                                                               },
                                                                                    "compile":  {
                                                                                                    "type":  "string",
                                                                                                    "description":  "Compile model before querying (\u0027true\u0027 or \u0027false\u0027). Required for compiled params like CompiledPortWidths"
                                                                                                }
                                                                                },
                                                                 "required":  [
                                                                                  "model",
                                                                                  "targets",
                                                                                  "params",
                                                                                  "compile"
                                                                              ]
                                                             }
                                         },
                  "model_resolve_params":  {
                                               "matlab_release":  "\u003e=R2023a",
                                               "matlab_function":  "model_resolve_params",
                                               "title":  "Model Resolve Params",
                                               "description":  "Resolve variable references from model_read expressions to actual numeric values. When model_read shows @Param(Kp), this tool returns the value of Kp from MATLAB workspaces.\n\nPass expressions exactly as seen in model_read (e.g., \"Kp\", \"cfg.gains.Ki\", \"TableData(1,:)\"). Searches base workspace, model workspace, mask workspaces, and data dictionaries.\n\nResults organized by workspace source; shadowed variables include users list to identify which blocks use each definition.\n\nUnsupported: arithmetic (Kp+Ki), function calls (sqrt(2)), matrix literals ([1 2 3]). Use evaluate_matlab_code for these.",
                                               "annotations":  {
                                                                   "readOnlyHint":  true,
                                                                   "destructiveHint":  false,
                                                                   "idempotentHint":  true,
                                                                   "openWorldHint":  false
                                                               },
                                               "inputSchema":  {
                                                                   "type":  "object",
                                                                   "properties":  {
                                                                                      "model":  {
                                                                                                    "type":  "string",
                                                                                                    "description":  "Model filename (e.g. MyModel.slx)"
                                                                                                },
                                                                                      "expressions":  {
                                                                                                          "type":  "string",
                                                                                                          "description":  "JSON array of expressions to resolve, e.g. \u0027[\"Kp\", \"cfg.gains.Ki\"]\u0027"
                                                                                                      }
                                                                                  },
                                                                   "required":  [
                                                                                    "model",
                                                                                    "expressions"
                                                                                ]
                                                               }
                                           },
                  "model_edit":  {
                                     "matlab_release":  "\u003e=R2023a",
                                     "matlab_function":  "model_edit",
                                     "title":  "Model Edit",
                                     "description":  "Make structural changes or configure parameters in a Simulink, System Composer, or Stateflow model within ONE scope per call. Use model_read first to get block IDs.\n\nOperations (executed in array order):\n- add_block: {op, type, name?, ref?, params?, position?} - Add block or SF element. SL params e.g. {Gain: \"2.0\"}; SF types: State, Junction, Box, Data, Event, Message, StateflowFunction, EMFunction, TruthTable\n- connect: {op, target: \"blk_X.y1 -\u003e blk_Y.u1\", params?} - Wire output to input (y=output port, u=input port); for physical ports use blk_X.portName \u003c-\u003e blk_Y.portName; in SF scope use portless \"#src -\u003e #dst\" or \"? -\u003e #dst\" (default transition); replaces existing connection if destination port occupied; params set signal properties (SL) or LabelString/ExecutionOrder (SF)\n- disconnect: {op, target: \"blk_X.y1 -\u003e blk_Y.u1\"} - Remove connection; in SF scope target is transition sf_X, endpoint pair \"sf_X -\u003e sf_Y\", or default \"? -\u003e sf_X\"\n- configure: {op, target, params} - Set Simulink parameters, System Composer component properties, or SF element properties. Target types: blk_X (block params), sf_X (SF element, e.g. {LabelString: \"...\"}), blk_X.y1 -\u003e blk_Y.u1 (signal props), config:ModelName (solver settings), or chart:ModelName (SF chart-level props, e.g. {ActionLanguage: \"MATLAB\"})\n- delete: {op, target: \"blk_X\"} - Remove block\n- replace_block: {op, target: \"blk_X\", type, ref?, params?} - Replace block with different type; preserves name, position, connections\n- create_subsystem: {op, name, ref?, interface: {inputs, outputs}} - Create subsystem; connect via #ref.yN/#ref.uN (N = port number from interface)\n\nFor parameter-only changes (no structural edits), use configure operations alone.\n\nChaining: Use \"ref\" to name a new block, \"#ref\" to reference it within the same call:\n  [{op: \"add_block\", type: \"Gain\", ref: \"g1\"}, {op: \"connect\", target: \"blk_5.y1 -\u003e #g1.u1\"}]\n\nResponse \"created\" map shows ref → blk_id (or sf_X in SF scope). In subsequent calls, use the returned ID instead of #ref. Use model_query_params to discover valid parameter names. Operations continue on error.\n\nIMPORTANT: The operations parameter MUST be single-line JSON with no newlines.",
                                     "annotations":  {
                                                         "readOnlyHint":  false,
                                                         "destructiveHint":  true,
                                                         "idempotentHint":  false,
                                                         "openWorldHint":  false
                                                     },
                                     "inputSchema":  {
                                                         "type":  "object",
                                                         "properties":  {
                                                                            "model":  {
                                                                                          "type":  "string",
                                                                                          "description":  "Model filename (e.g. MyModel.slx)"
                                                                                      },
                                                                            "scope":  {
                                                                                          "type":  "string",
                                                                                          "description":  "Where to operate: \u0027root\u0027, subsystem block ID \u0027blk_5\u0027, or Stateflow scope \u0027sf_X\u0027 (chart/state/box). Chart blk_X auto-detects as SF. All ops within this scope."
                                                                                      },
                                                                            "operations":  {
                                                                                               "type":  "string",
                                                                                               "description":  "JSON array of operation objects (MUST be single-line, no newlines). Each has \u0027op\u0027 (add_block|connect|disconnect|configure|delete|replace_block|create_subsystem) and operation-specific fields."
                                                                                           },
                                                                            "layout_mode":  {
                                                                                                "type":  "string",
                                                                                                "description":  "Layout mode for this call: \u0027full\u0027 (use when scope is empty/building from scratch) or \u0027incremental\u0027 (use when adding to existing model). Always provide this parameter.",
                                                                                                "enum":  [
                                                                                                             "full",
                                                                                                             "incremental"
                                                                                                         ]
                                                                                            }
                                                                        },
                                                         "required":  [
                                                                          "model",
                                                                          "scope",
                                                                          "operations"
                                                                      ]
                                                     }
                                 },
                  "model_check":  {
                                      "matlab_release":  "\u003e=R2023a",
                                      "matlab_function":  "model_check",
                                      "title":  "Model Check",
                                      "description":  "Validate a Simulink model for structural issues. Prefer model_context first when deciding what scope to inspect; then run model_check on the narrowest relevant scope after edits or when structural validation is explicitly needed.\n\nValidate a Simulink model for structural issues. Detects unconnected ports, dangling signal lines, and Stateflow edit-time lint errors. Use after model_edit to catch connectivity problems, or to audit an existing model\u0027s structural health.\n\nChecks available:\n- unconnected_ports: blocks with inputs/outputs that have no signal connected\n- unconnected_lines: signal lines missing a source or destination\n- stateflow_lint: edit-time lint diagnostics on Chart and StateTransitionTable blocks\n\nReturns issue list with severity (error/warning), block IDs, and actionable messages. Use scope to focus on a specific subsystem for faster, targeted validation.",
                                      "annotations":  {
                                                          "readOnlyHint":  true,
                                                          "destructiveHint":  false,
                                                          "idempotentHint":  true,
                                                          "openWorldHint":  false
                                                      },
                                      "inputSchema":  {
                                                          "type":  "object",
                                                          "properties":  {
                                                                             "model":  {
                                                                                           "type":  "string",
                                                                                           "description":  "Model filename (e.g. MyModel.slx)"
                                                                                       },
                                                                             "scope":  {
                                                                                           "type":  "string",
                                                                                           "description":  "Validation scope: \u0027root\u0027 for entire model or a block ID like \u0027blk_10\u0027 for a specific subsystem"
                                                                                       },
                                                                             "checks":  {
                                                                                            "type":  "string",
                                                                                            "description":  "JSON array of check names to run: \u0027[\"all\"]\u0027 (default), or selective like \u0027[\"unconnected_ports\", \"unconnected_lines\"]\u0027. Available: unconnected_ports, unconnected_lines, stateflow_lint"
                                                                                        }
                                                                         },
                                                          "required":  [
                                                                           "model",
                                                                           "scope",
                                                                           "checks"
                                                                       ]
                                                      }
                                  },
                  "model_test":  {
                                     "matlab_release":  "\u003e=R2023a",
                                     "matlab_function":  "model_test",
                                     "title":  "Model Test",
                                     "description":  "Execute behavioral tests against a Simulink model using a Gherkin-format specification file. Auto-creates test artifacts and returns pytest-style results. IMPORTANT: Load the \u0027testing-simulink-models\u0027 skill before writing .feature files — the Gherkin format requires TOML front-matter and custom step syntax not found in standard Gherkin. ROUTING: When a user asks to \u0027generate tests\u0027, \u0027write test cases\u0027, or \u0027verify requirements\u0027 for a Simulink model or subsystem, ALWAYS use this tool with the testing-simulink-models skill — never write matlab.unittest.TestCase classes that reimplement model logic in MATLAB.",
                                     "annotations":  {
                                                         "readOnlyHint":  false,
                                                         "destructiveHint":  false,
                                                         "idempotentHint":  true,
                                                         "openWorldHint":  false
                                                     },
                                     "inputSchema":  {
                                                         "type":  "object",
                                                         "properties":  {
                                                                            "model":  {
                                                                                          "type":  "string",
                                                                                          "description":  "Model filename (e.g. MyModel.slx)"
                                                                                      },
                                                                            "gherkin_file":  {
                                                                                                 "type":  "string",
                                                                                                 "description":  "Path to Gherkin test specification file"
                                                                                             },
                                                                            "scenarios":  {
                                                                                              "type":  "string",
                                                                                              "description":  "JSON array of scenario names to run, e.g. \u0027[\"Scenario1\", \"Scenario2\"]\u0027. Use \u0027[]\u0027 to run all scenarios."
                                                                                          },
                                                                            "verbose":  {
                                                                                            "type":  "string",
                                                                                            "description":  "Include signal traces on failure (\u0027true\u0027 or \u0027false\u0027). Default: false"
                                                                                        },
                                                                            "draft_mode":  {
                                                                                               "type":  "string",
                                                                                               "description":  "Skip main model compile for faster iteration (\u0027true\u0027 or \u0027false\u0027). Use \u0027true\u0027 by default for rapid test development (~3s vs ~60s). If draft mode fails due to type/bus/dimension issues, re-run with \u0027false\u0027. Default: false"
                                                                                           },
                                                                            "coverage":  {
                                                                                             "type":  "string",
                                                                                             "enum":  [
                                                                                                          "none",
                                                                                                          "decision"
                                                                                                      ],
                                                                                             "description":  "Coverage metric to collect: \u0027none\u0027 (default) or \u0027decision\u0027. Requires Simulink Coverage toolbox."
                                                                                         }
                                                                        },
                                                         "required":  [
                                                                          "model",
                                                                          "gherkin_file",
                                                                          "scenarios",
                                                                          "verbose",
                                                                          "draft_mode",
                                                                          "coverage"
                                                                      ]
                                                     }
                                 },
                  "model_context":  {
                                        "name":  "model_context",
                                        "title":  "Model Context",
                                        "description":  "FIRST-CHOICE structural context for Simulink engineering tasks. The first call builds one complete compile-free model snapshot; later calls resolve scopes and return compact context from that snapshot without loading the model. Use targeted model_read calls when exact algorithmic expressions or current edit identifiers are required.",
                                        "annotations":  {
                                                            "readOnlyHint":  true,
                                                            "destructiveHint":  false,
                                                            "idempotentHint":  true,
                                                            "openWorldHint":  false
                                                        },
                                        "inputSchema":  {
                                                            "type":  "object",
                                                            "properties":  {
                                                                               "task":  {
                                                                                            "type":  "string",
                                                                                            "description":  "Natural-language engineering task or question"
                                                                                        },
                                                                               "model":  {
                                                                                             "type":  "string",
                                                                                             "description":  "Model filename/path or auto",
                                                                                             "default":  "auto"
                                                                                         },
                                                                               "scope":  {
                                                                                             "type":  "string",
                                                                                             "description":  "root, auto, or Simulink block/subsystem path",
                                                                                             "default":  "auto"
                                                                                         },
                                                                               "cachePolicy":  {
                                                                                                   "type":  "string",
                                                                                                   "enum":  [
                                                                                                                "use-if-fresh",
                                                                                                                "cache-only",
                                                                                                                "force-refresh"
                                                                                                            ],
                                                                                                   "default":  "use-if-fresh"
                                                                                               }
                                                                           },
                                                            "required":  [
                                                                             "task"
                                                                         ]
                                                        },
                                        "matlab_release":  "\u003e=R2023a",
                                        "matlab_function":  "model_context"
                                    },
